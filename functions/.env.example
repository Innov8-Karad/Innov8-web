# ═══════════════════════════════════════════════════════════════════════════════
# Innov8 Cloud Functions — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values before deploying.
# Firebase Functions v2 loads .env automatically from this directory.
# ═══════════════════════════════════════════════════════════════════════════════

# Cloudinary credentials (used by deleteCloudinaryAsset function)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
