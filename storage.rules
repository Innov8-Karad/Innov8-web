rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Innov8 Unified Storage Security Rules
// Firebase Project: innov8-karad
// Last Updated: 2026-04-04
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile Photos ─────────────────────────────────────────────────
    // Admin uploads to: profilePhotos/{timestamp}_{random}.ext (flat path)
    // Students upload to: profilePhotos/{userId}/... (nested path)
    // Both patterns must be supported.

    // Flat path: Admin uploads directly into profilePhotos/
    match /profilePhotos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Nested path: Users upload into their own subfolder
    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Success Story Photos ───────────────────────────────────────────
    // Admin uploads to: successStories/{timestamp}_{random}.ext
    match /successStories/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Course Thumbnails ──────────────────────────────────────────────
    // Public read, authenticated write
    match /courseThumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Study Materials ────────────────────────────────────────────────
    // Authenticated read, authenticated write (admin uploads)
    match /studyMaterials/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Company Logos ──────────────────────────────────────────────────
    // Public read, authenticated write
    match /companyLogos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Resumes ────────────────────────────────────────────────────────
    // Users read/write their own
    match /resumes/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Fee Receipts ───────────────────────────────────────────────────
    // Users read their own, admin uploads
    match /receipts/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null;
    }
  }
}
