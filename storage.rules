rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Innov8 Unified Storage Security Rules
// Firebase Project: innov8-karad
// Last Updated: 2026-04-04
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper: Check if user is admin ──
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Max file size: 5MB
    function isUnderSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ── Profile Photos ─────────────────────────────────────────────────
    // Flat path: Admin uploads directly into profilePhotos/
    match /profilePhotos/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isUnderSizeLimit();
    }

    // Nested path: Users upload into their own subfolder
    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && isUnderSizeLimit();
    }

    // ── Success Story Photos (Admin only) ───────────────────────────
    match /successStories/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isUnderSizeLimit();
    }

    // ── Course Thumbnails (Admin only) ──────────────────────────────
    match /courseThumbnails/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isUnderSizeLimit();
    }

    // ── Study Materials (Admin only) ────────────────────────────────
    match /studyMaterials/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isUnderSizeLimit();
    }

    // ── Company Logos (Admin only) ──────────────────────────────────
    match /companyLogos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isUnderSizeLimit();
    }

    // ── Resumes (User-owned) ────────────────────────────────────────
    match /resumes/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && isUnderSizeLimit();
    }

    // ── Fee Receipts (User reads own, admin writes) ─────────────────
    match /receipts/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && isUnderSizeLimit();
    }
  }
}
