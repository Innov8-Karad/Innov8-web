rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Innov8 Unified Firestore Security Rules
// Firebase Project: innov8-karad
// Covers: Innov8-web (Admin Portal) + Innov8-mobile (Student App)
// Last Updated: 2026-04-04
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNotBlocked() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth.token.get('isBlocked', false) != true
          && userDoc.get('isBlocked', false) != true
          && request.auth.token.get('tokenVersion', 0) >= userDoc.get('tokenVersion', 0);
    }

    // Authenticated AND not blocked (for student-facing reads)
    function isActiveUser() {
      return isAuthenticated() && isNotBlocked();
    }

    // ═════════════════════════════════════════════════════════════════════
    // 1. USERS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL students (dashboard, exam results, announcements)
    //             Creates students via addDoc (random doc ID)
    //             Updates and deletes any user
    // Mobile:     Reads own doc (profile, dashboard)
    //             Creates own doc during signup via setDoc(uid)
    //             Cannot change own role
    // ═════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isAdmin() || (isOwner(userId) && isNotBlocked());

      allow create: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == 'student'
                        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'activeDeviceDocId']));

      allow update: if isAdmin()
                    || (isOwner(userId)
                        // Students can only update specific profile fields
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['name', 'phone', 'profilePhoto', 'skills', 'fcmTokens', 'activeDeviceDocId', 'updatedAt'])
                        // Basic safeguards
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.email == resource.data.email
                        // Cannot unblock themselves
                        && request.resource.data.get('isBlocked', false) == resource.data.get('isBlocked', false)
                        // Cannot change token version
                        && request.resource.data.get('tokenVersion', 0) == resource.data.get('tokenVersion', 0)
                        // Device locking: can set but not change
                        && (resource.data.activeDeviceDocId == null || request.resource.data.activeDeviceDocId == resource.data.activeDeviceDocId));

      allow delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 2. FEES
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL fees (dashboard totals, listing, charts)
    //             Creates fee records, updates fee status
    // Mobile:     Reads own fees via where('studentId', '==', uid)
    // ═════════════════════════════════════════════════════════════════════
    match /fees/{feeId} {
      allow read: if isAdmin()
                  || (isActiveUser()
                      && (resource.data.studentId == request.auth.uid
                          || resource.data.userId == request.auth.uid));

      allow create, update, delete: if isAdmin();

      // Payment history subcollection (installments)
      match /paymentHistory/{paymentId} {
        allow read: if isAdmin()
                    || (isAuthenticated());
        allow create, update, delete: if isAdmin();
      }
    }


    // ═════════════════════════════════════════════════════════════════════
    // 3. COURSES + SUBCOLLECTIONS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD on courses, modules, resources, assignments
    // Mobile:     Reads all courses and subcollections
    // ═════════════════════════════════════════════════════════════════════
    match /courses/{courseId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purchasedBy'])
                        && request.resource.data.purchasedBy.size() == (resource.data.get('purchasedBy', []).size() + 1)
                        && request.resource.data.purchasedBy.hasAll(resource.data.get('purchasedBy', []))
                        && request.resource.data.purchasedBy.hasAll([request.auth.uid]));

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();

        // ── Assignment Submissions (students upload, admins grade) ──
        match /submissions/{submissionId} {
          allow read: if isAdmin()
                      || (isAuthenticated()
                          && resource.data.userId == request.auth.uid);

          allow create: if isAuthenticated()
                        && request.resource.data.userId == request.auth.uid;

          allow update: if isAdmin();

          allow delete: if isAdmin();
        }
      }
    }


    // ═════════════════════════════════════════════════════════════════════
    // 4. EXAMS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD, dashboard queries with various filters
    // Mobile:     Reads all exams, reads single exam by ID
    // ═════════════════════════════════════════════════════════════════════
    match /exams/{examId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 5. EXAM RESULTS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL results (exam results dashboard, no filter)
    // Mobile:     Reads own results via where('userId', '==', uid)
    //             Creates own result after submitting an exam
    // ═════════════════════════════════════════════════════════════════════
    match /examResults/{resultId} {
      allow read: if isAdmin()
                  || (isActiveUser()
                      && resource.data.userId == request.auth.uid);

      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 6. ANNOUNCEMENTS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD
    // Mobile:     Reads all (client-side filtering by batch/audience)
    // ═════════════════════════════════════════════════════════════════════
    match /announcements/{announcementId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 7. ATTENDANCE
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL (various filters: batchId, studentId, fetchAll)
    //             Writes via batch writes and single updates
    // Mobile:     Reads own via where('studentEmail', '==', user.email)
    //             NOTE: Mobile queries by email, NOT studentId
    // ═════════════════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {
      allow read: if isAdmin()
                  || (isActiveUser()
                      && (resource.data.studentId == request.auth.uid
                          || resource.data.studentEmail == request.auth.token.email));

      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 8. PLACEMENTS (Success Stories)
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD, dashboard reads entire collection
    // Mobile:     Reads all (useSuccessStories, usePlacements)
    // ═════════════════════════════════════════════════════════════════════
    match /placements/{placementId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 9. PLACEMENT STATS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads/writes (query by year, create/update)
    // Mobile:     Reads all
    // ═════════════════════════════════════════════════════════════════════
    match /placementStats/{statId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 10. JOBS + APPLICATIONS SUBCOLLECTION
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD on jobs, reads all applications, updates status
    // Mobile:     Reads all jobs, reads own applications (collectionGroup),
    //             creates own application
    // ═════════════════════════════════════════════════════════════════════
    match /jobs/{jobId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();

      match /applications/{applicationId} {
        allow read: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.userId == request.auth.uid);

        allow create: if isActiveUser()
                      && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    // Collection Group query support for applications
    // Mobile uses: collectionGroup(db, 'applications') with where('userId','==',uid)
    match /{path=**}/applications/{applicationId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && resource.data.userId == request.auth.uid);
    }


    // ═════════════════════════════════════════════════════════════════════
    // 11. USER PROGRESS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL (progressService.fetchProgress), updates individual
    // Mobile:     Reads own doc (ID format: {userId}_{courseId})
    //             Writes own progress
    // ═════════════════════════════════════════════════════════════════════
    match /user_progress/{docId} {
      allow read: if isAdmin()
                  || (isActiveUser()
                      && (docId == request.auth.uid 
                          || docId.matches("^" + request.auth.uid + "(_.*)?$")
                          || resource.data.userId == request.auth.uid));

      allow list: if isAdmin()
                  || (isAuthenticated()
                      && (resource.data.userId == request.auth.uid
                          || resource.data.email == request.auth.token.email));

      allow write: if isAdmin()
                   || (isAuthenticated()
                       && (docId == request.auth.uid 
                           || docId.matches("^" + request.auth.uid + "(_.*)?$")
                           || request.resource.data.userId == request.auth.uid));
    }

    // Legacy 'progress' collection (backward compatibility)
    match /progress/{docId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && (docId == request.auth.uid
                          || docId.matches("^" + request.auth.uid + "(_.*)?$")));

      allow write: if isAdmin()
                   || (isAuthenticated()
                       && (docId == request.auth.uid
                           || docId.matches("^" + request.auth.uid + "(_.*)?$")));
    }


    // ═════════════════════════════════════════════════════════════════════
    // 12. OPPORTUNITIES
    // ─────────────────────────────────────────────────────────────────────
    // Mobile:  Reads all (usePlacements hook)
    // ═════════════════════════════════════════════════════════════════════
    match /opportunities/{opportunityId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 13. INTERVIEWS
    // ═════════════════════════════════════════════════════════════════════
    match /interviews/{interviewId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 14. SUCCESS STORIES (alternate collection name)
    // ─────────────────────────────────────────────────────────────────────
    match /successStories/{storyId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 15. STUDY MATERIALS
    // ─────────────────────────────────────────────────────────────────────
    match /studyMaterials/{materialId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 16. DEVICES (Login Approval System)
    // ─────────────────────────────────────────────────────────────────────
    // Mobile:  Reads own device docs (userId == auth.uid)
    //          Creates own device doc on login attempt
    // Admin:   Reads ALL device docs, updates status (approve/reject)
    // ═════════════════════════════════════════════════════════════════════
    match /devices/{deviceDocId} {
      // Allow reading if Admin OR if it's the user's own device document
      // Note: For list queries, the query MUST filter by userId == auth.uid
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && (resource == null || resource.data.userId == request.auth.uid));

      // Allow creating own device document
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status in ['approved', 'pending']
                    && request.resource.data.keys().hasAll(
                        ['userId', 'deviceId', 'status', 'deviceMeta', 'createdAt']);

      // Update rules:
      // 1. Admin can update anything (approve, reject, revoke)
      // 2. Owner can ONLY transition from "revoked" → "pending" (re-request)
      //    This prevents users from approving themselves.
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.userId == request.auth.uid
                        && resource.data.status == 'revoked'
                        && request.resource.data.status == 'pending');

      allow delete: if isAdmin();
    }


    // 17. BATCHES
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD
    // Mobile:     Reads all available batches for selection
    // ═════════════════════════════════════════════════════════════════════
    match /batches/{batchId} {
      allow read: if isAdmin() || isActiveUser();
      allow write: if isAdmin();
      match /{allChildren=**} {
        allow read: if isAdmin() || isActiveUser();
        allow write: if isAdmin();
      }
    }


    // 18. ENROLLMENT REQUESTS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads all, updates status to approve/reject
    // Mobile:     Creates own request, reads own request status
    // ═════════════════════════════════════════════════════════════════════
    match /enrollment_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin() || (isActiveUser() && (request.resource == null || request.resource.data.userId == request.auth.uid));
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isActiveUser() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }


    // 19. COURSE PURCHASES
    // ═════════════════════════════════════════════════════════════════════
    match /course_purchases/{purchaseId} {
      allow read: if isAdmin() 
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════════════════
    // 20. PLACEMENT TALLY
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD
    // ═════════════════════════════════════════════════════════════════════
    match /placementTally/{studentId} {
      allow read, write: if isAdmin();
    }

  }
}
