rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Allow students to read their own doc without needing isAdmin check
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'student'
                    && request.resource.data.keys().hasAll(['name', 'email', 'role']);
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ── Fees ─────────────────────────────────────────────────────────────
    // Harmonized: allows reading by 'studentId' OR 'userId' field.
    match /fees/{feeId} {
      allow read: if isAuthenticated()
                  && (resource.data.studentId == request.auth.uid 
                      || resource.data.userId == request.auth.uid 
                      || isAdmin());
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['amount', 'status']);
      allow update, delete: if isAdmin();
    }

    // ── Courses ──────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['title']);
      allow update, delete: if isAdmin();

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ── Exams ────────────────────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['title', 'scheduledDate']);
      allow update, delete: if isAdmin();
    }

    // ── Announcements ────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['title', 'content', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // ── Placements & Success Stories ─────────────────────────────────────
    // Unified: Both collections are now auth-gated for reading.
    match /placements/{placementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /successStories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── User Progress ──
    match /user_progress/{docId} {
      allow read, write: if isAuthenticated() && (isAdmin() || docId.split('_')[0] == request.auth.uid);
    }

    // ── Exam Results ─────────────────────────────────────────────────────
    match /examResults/{resultId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    // ── Jobs ─────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // ── Applications sub-collection ──
      match /applications/{applicationId} {
        allow read: if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isAuthenticated()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.keys().hasAll(['userId', 'jobId', 'status', 'appliedAt']);
        allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    // ── Collection Group: Applications ───────────────────────────────────
    match /{path=**}/applications/{applicationId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Interviews & Study Materials ─────────────────────────────────────
    match /interviews/{interviewId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /studyMaterials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Attendance ───────────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated()
                  && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Placement Stats & Opportunities ──────────────────────────────────
    match /placementStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
