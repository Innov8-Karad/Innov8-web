rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users ────────────────────────────────────────────────────────────
    // Students read/write own doc; admin reads/writes all.
    // CRITICAL: Students CANNOT change their own 'role' field.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'student'
                    && request.resource.data.keys().hasAll(['name', 'email', 'role']);
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ── Fees ─────────────────────────────────────────────────────────────
    // Students read own fees (matched by 'studentId' field); admin full.
    // Mobile query: where('studentId', '==', uid)
    match /fees/{feeId} {
      allow read: if isAuthenticated()
                  && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['studentId', 'amount', 'dueDate', 'status']);
      allow update, delete: if isAdmin();
    }

    // ── Courses ──────────────────────────────────────────────────────────
    // All authenticated users read; admin creates with required 'title'.
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['title']);
      allow update, delete: if isAdmin();

      // ── Course Modules (Curriculum) ──
      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // ── Course Resources ──
      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // ── Course Assignments ──
      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ── Exams ────────────────────────────────────────────────────────────
    // All authenticated users read; admin creates with required fields.
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['title', 'scheduledDate']);
      allow update, delete: if isAdmin();
    }

    // ── Announcements ────────────────────────────────────────────────────
    // All authenticated users read; admin creates with required fields.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['title', 'content', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // ── Placements ───────────────────────────────────────────────────────
    // HARDENED: Was public (allow read: if true) → now auth-gated.
    match /placements/{placementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Success Stories ──────────────────────────────────────────────────
    // HARDENED: Was public (allow read: if true) → now auth-gated.
    match /successStories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── User Progress (Format: {userId}_{courseId}) ──
    match /user_progress/{docId} {
      allow read, write: if isAuthenticated() && (isAdmin() || docId.split('_')[0] == request.auth.uid);
    }

    // ── Exam Results ─────────────────────────────────────────────────────
    // Field-scoped: students read only docs where userId == their uid.
    // Mobile query MUST include: where('userId', '==', uid)
    match /examResults/{resultId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Jobs ─────────────────────────────────────────────────────────────
    // Placeholder: authenticated read, admin write.
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Interviews ───────────────────────────────────────────────────────
    // Placeholder: authenticated read, admin write.
    match /interviews/{interviewId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Study Materials ──────────────────────────────────────────────────
    // Placeholder: authenticated read, admin write.
    match /studyMaterials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Attendance ───────────────────────────────────────────────────────
    // HARDENED: Was open read → now scoped to student's own records.
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated()
                  && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Placement Stats ──────────────────────────────────────────────────
    // NEW: Was missing entirely → now auth-gated read, admin write.
    match /placementStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Opportunities ────────────────────────────────────────────────────
    // NEW: Was missing entirely → now auth-gated read, admin write.
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
