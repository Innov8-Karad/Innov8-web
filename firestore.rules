rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users — students read/write own, admin reads/writes all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Fees — students read own, admin full access
    match /fees/{feeId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Courses — authenticated read, admin write
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Exams — authenticated read, admin write
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Announcements — authenticated read, admin write
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Placements — public read, admin write
    match /placements/{placementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Success Stories — public read, admin write
    match /successStories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Progress — students read own, admin full access
    match /progress/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Exam Results — students read own, admin full access
    match /examResults/{resultId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Jobs — authenticated users can read, admin write
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Interviews — authenticated users can read, admin write
    match /interviews/{interviewId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Study Materials — authenticated users can read, admin write
    match /studyMaterials/{materialId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Attendance — students read own, admin full access
    match /attendance/{attendanceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
