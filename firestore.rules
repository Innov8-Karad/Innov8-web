rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Innov8 Unified Firestore Security Rules
// Firebase Project: innov8-karad
// Covers: Innov8-web (Admin Portal) + Innov8-mobile (Student App)
// Last Updated: 2026-04-04
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
          && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // ═════════════════════════════════════════════════════════════════════
    // 1. USERS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL students (dashboard, exam results, announcements)
    //             Creates students via addDoc (random doc ID)
    //             Updates and deletes any user
    // Mobile:     Reads own doc (profile, dashboard)
    //             Creates own doc during signup via setDoc(uid)
    //             Cannot change own role
    // ═════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read, write: if isAuthenticated(); // DIAGNOSTIC: Relaxed to fix approval flow
    }


    // ═════════════════════════════════════════════════════════════════════
    // 2. FEES
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL fees (dashboard totals, listing, charts)
    //             Creates fee records, updates fee status
    // Mobile:     Reads own fees via where('studentId', '==', uid)
    // ═════════════════════════════════════════════════════════════════════
    match /fees/{feeId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && (resource.data.studentId == request.auth.uid
                          || resource.data.userId == request.auth.uid));

      allow create, update, delete: if isAdmin();

      // Payment history subcollection (installments)
      match /paymentHistory/{paymentId} {
        allow read: if isAdmin()
                    || (isAuthenticated());
        allow create, update, delete: if isAdmin();
      }
    }


    // ═════════════════════════════════════════════════════════════════════
    // 3. COURSES + SUBCOLLECTIONS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD on courses, modules, resources, assignments
    // Mobile:     Reads all courses and subcollections
    // ═════════════════════════════════════════════════════════════════════
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();

        // ── Assignment Submissions (students upload, admins grade) ──
        match /submissions/{submissionId} {
          allow read: if isAdmin()
                      || (isAuthenticated()
                          && resource.data.userId == request.auth.uid);

          allow create: if isAuthenticated()
                        && request.resource.data.userId == request.auth.uid;

          allow update: if isAdmin();

          allow delete: if isAdmin();
        }
      }
    }


    // ═════════════════════════════════════════════════════════════════════
    // 4. EXAMS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD, dashboard queries with various filters
    // Mobile:     Reads all exams, reads single exam by ID
    // ═════════════════════════════════════════════════════════════════════
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 5. EXAM RESULTS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL results (exam results dashboard, no filter)
    // Mobile:     Reads own results via where('userId', '==', uid)
    //             Creates own result after submitting an exam
    // ═════════════════════════════════════════════════════════════════════
    match /examResults/{resultId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 6. ANNOUNCEMENTS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD
    // Mobile:     Reads all (client-side filtering by batch/audience)
    // ═════════════════════════════════════════════════════════════════════
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 7. ATTENDANCE
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL (various filters: batchId, studentId, fetchAll)
    //             Writes via batch writes and single updates
    // Mobile:     Reads own via where('studentEmail', '==', user.email)
    //             NOTE: Mobile queries by email, NOT studentId
    // ═════════════════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && (resource.data.studentId == request.auth.uid
                          || resource.data.studentEmail == request.auth.token.email));

      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 8. PLACEMENTS (Success Stories)
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD, dashboard reads entire collection
    // Mobile:     Reads all (useSuccessStories, usePlacements)
    // ═════════════════════════════════════════════════════════════════════
    match /placements/{placementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 9. PLACEMENT STATS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads/writes (query by year, create/update)
    // Mobile:     Reads all
    // ═════════════════════════════════════════════════════════════════════
    match /placementStats/{statId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 10. JOBS + APPLICATIONS SUBCOLLECTION
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD on jobs, reads all applications, updates status
    // Mobile:     Reads all jobs, reads own applications (collectionGroup),
    //             creates own application
    // ═════════════════════════════════════════════════════════════════════
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      match /applications/{applicationId} {
        allow read: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.userId == request.auth.uid);

        allow create: if isAuthenticated()
                      && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    // Collection Group query support for applications
    // Mobile uses: collectionGroup(db, 'applications') with where('userId','==',uid)
    match /{path=**}/applications/{applicationId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && resource.data.userId == request.auth.uid);
    }


    // ═════════════════════════════════════════════════════════════════════
    // 11. USER PROGRESS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads ALL (progressService.fetchProgress), updates individual
    // Mobile:     Reads own doc (ID format: {userId}_{courseId})
    //             Writes own progress
    // ═════════════════════════════════════════════════════════════════════
    match /user_progress/{docId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && (docId == request.auth.uid 
                          || docId.matches("^" + request.auth.uid + "(_.*)?$")
                          || resource.data.userId == request.auth.uid));

      allow list: if isAdmin()
                  || (isAuthenticated()
                      && (resource.data.userId == request.auth.uid
                          || resource.data.email == request.auth.token.email));

      allow write: if isAdmin()
                   || (isAuthenticated()
                       && (docId == request.auth.uid 
                           || docId.matches("^" + request.auth.uid + "(_.*)?$")
                           || request.resource.data.userId == request.auth.uid));
    }

    // Legacy 'progress' collection (backward compatibility)
    match /progress/{docId} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && (docId == request.auth.uid
                          || docId.matches("^" + request.auth.uid + "(_.*)?$")));

      allow write: if isAdmin()
                   || (isAuthenticated()
                       && (docId == request.auth.uid
                           || docId.matches("^" + request.auth.uid + "(_.*)?$")));
    }


    // ═════════════════════════════════════════════════════════════════════
    // 12. OPPORTUNITIES
    // ─────────────────────────────────────────────────────────────────────
    // Mobile:  Reads all (usePlacements hook)
    // ═════════════════════════════════════════════════════════════════════
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 13. INTERVIEWS
    // ═════════════════════════════════════════════════════════════════════
    match /interviews/{interviewId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 14. SUCCESS STORIES (alternate collection name)
    // ═════════════════════════════════════════════════════════════════════
    match /successStories/{storyId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 15. STUDY MATERIALS
    // ═════════════════════════════════════════════════════════════════════
    match /studyMaterials/{materialId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════
    // 16. BATCHES
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Full CRUD
    // Mobile:     Reads all available batches for selection
    // ═════════════════════════════════════════════════════════════════════
    match /batches/{batchId} {
      allow read, write: if isAuthenticated(); 
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }


    // ═════════════════════════════════════════════════════════════════════
    // 17. ENROLLMENT REQUESTS
    // ─────────────────────────────────────────────────────────────────────
    // Web Admin:  Reads all, updates status to approve/reject
    // Mobile:     Creates own request, reads own request status
    // ═════════════════════════════════════════════════════════════════════
    match /enrollment_requests/{requestId} {
      allow read, write: if isAuthenticated(); // DIAGNOSTIC: Relaxed to fix approval flow
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated(); // DIAGNOSTIC: Relaxed to fix approval flow
    }

  }
}
