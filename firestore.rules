rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users — students can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fees — students can read their own, write is admin-only
    match /fees/{feeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Admin SDK only
    }

    // Exams — authenticated users can read, write is admin-only
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Interviews — authenticated users can read, write is admin-only
    match /interviews/{interviewId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Jobs — authenticated users can read, write is admin-only
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Placements — public read, write is admin-only
    match /placements/{placementId} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    // Progress — students can read their own, write is admin-only
    match /progress/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Admin SDK only
    }

    // Announcements — authenticated users can read, write is admin-only
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Courses — authenticated users can read, write is admin-only
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Study Materials — authenticated users can read, write is admin-only
    match /studyMaterials/{materialId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Exam Results — students can read their own, write is admin-only
    match /examResults/{resultId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Admin SDK only
    }
  }
}
